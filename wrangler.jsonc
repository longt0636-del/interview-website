// Cấu hình chạy web tuyển sinh (bài test đầu vào) trên Cloudflare Workers (25/10/2026).
// Build + deploy: `bash scripts/cf-docker-build.sh build deploy`. Khoá Google đặt bằng `wrangler secret`.
// TỰ ĐƯA LÊN (26/10/2026): Workers Builds đã nối repo này — đẩy nhánh `main` là Cloudflare tự dựng (`node scripts/cf-build.mjs`)
// rồi đưa lên (`npx opennextjs-cloudflare deploy`) sau 5–10 phút. Lỗi dựng: dash.cloudflare.com → Workers & Pages → worker này → Builds.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  // Link gọn gửi phụ huynh/học viên mới (Long 26/10/2026): test.longielts.website — tên miền chính đã ở Cloudflare (xem
  // wrangler.jsonc của portal). workers_dev GIỮ true: link website.longielts.workers.dev đã gửi vẫn chạy.
  "workers_dev": true,
  "routes": [{ "pattern": "test.longielts.website", "custom_domain": true }],
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // /media/* (video trang chủ) + /audio/* (bài nghe, 26/10/2026) đi qua worker trước để có tua (Range) cho iPhone — xem cloudflare/worker.ts.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": ["/media/*", "/audio/*"] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "website" }],
  "r2_buckets": [
    // File ghi âm Speaking của học viên — RIÊNG TƯ, chỉ mở qua /api/recording (không chung kho công khai với portal).
    { "binding": "RECORDINGS", "bucket_name": "longielts-recordings" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "longielts-next-cache" }
  ],
  "vars": { "NEXT_INC_CACHE_R2_PREFIX": "website" },
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Lỗi (5xx, lỗi ném ra, console.error) gửi sang Tail Worker "error-sink" → bảng runtime_errors cho routine đọc.
  "tail_consumers": [{ "service": "error-sink" }]
}
